# Application Environment
APP_ENV=dev
LOG_LEVEL=info

# CORS and WebSocket Configuration
ALLOWED_ORIGINS=http://localhost:5173

# Input Limits (bytes)
MAX_SNAPSHOT_BYTES=1048576
MAX_FRAME_BYTES=5242880
MAX_MESSAGE_BYTES=1048576

# Frontend Configuration (for Vite build)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Analysis Configuration
ENABLED_ANALYZERS=treesitter,python_ast,ruff
ENABLED_LANGUAGES=python

# Execution Configuration
EXECUTION_ENABLED=true
SANDBOX_URL=http://localhost:8100
SANDBOX_SECRET=your-secret-key-here

# LLM Configuration
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=placeholder
LLM_MODEL=UNKNOWN
LLM_CONTEXT_TOKENS=4096
MENTOR_PROACTIVITY_DEFAULT=on_demand

# LLM Budget Limits (optional)
# HOSTED_LLM_BUDGET_SESSION=100
# HOSTED_LLM_BUDGET_DAY=1000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://mentor:password@localhost:5432/mentor

# Authentication
AUTH_MODE=single_user

# Data Retention
STORE_CODE_TEXT=true
RETENTION_DAYS=90

# Feature Flags
ADAPTATION_ENABLED=true
FEATURE_SCREEN_SOURCE=false
AUTO_CODE_DISCOVERY_ENABLED=true
FLOATING_MENTOR_ENABLED=true

# Vision/OCR Configuration (when screen source is enabled)
OCR_ENGINE=pytesseract
REGION_CONFIDENCE_GATE=0.8

# Development and Testing
DEBUG=false
TESTING=false