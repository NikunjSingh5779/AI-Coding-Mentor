# AI Coding Mentor
# Copy to .env. Replace all development secrets before any public deployment.

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://mentor:password@localhost:5433/mentor

# Real-time analysis
ENABLED_ANALYZERS=["python_ast","treesitter","ruff"]
ENABLED_LANGUAGES=["python","javascript","cpp","java","c"]
MAX_CODE_BYTES=250000
MAX_MESSAGE_BYTES=1048576

# Persistence/privacy
STORE_CODE_TEXT=false
RETENTION_DAYS=30

# Sandbox
EXECUTION_ENABLED=true
SANDBOX_URL=http://localhost:8100
SANDBOX_SECRET=change-me-sandbox-secret
SANDBOX_TIMEOUT=30
SANDBOX_MAX_TIMEOUT=60
SANDBOX_MAX_OUTPUT_BYTES=1048576
MAX_CONCURRENT_RUNS=3

# Mentor / LLM (OpenAI-compatible local or hosted endpoint)
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=none
LLM_MODEL=auto
LLM_TIMEOUT=30
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.2
MENTOR_MAX_HINTS_PER_SESSION=20
MENTOR_MAX_HINT_CHARS=900
ADAPTIVE_ENABLED=true
FLOATING_MENTOR_ENABLED=true

# Screen source / OCR
FEATURE_SCREEN_SOURCE=false
AUTO_CODE_DISCOVERY_ENABLED=true
OCR_ENGINE=tesseract
REGION_CONFIDENCE_GATE=0.55
MAX_FRAME_BYTES=2097152
SCREEN_SAMPLE_INTERVAL_MS=1500

# Browser
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_SCREEN_SOURCE_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
