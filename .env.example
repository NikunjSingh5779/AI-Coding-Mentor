# AI Real-Time Coding Screener - Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# Application Configuration
# =============================================================================
DEBUG=false
HOST=127.0.0.1
PORT=8000
SECRET_KEY=your-secret-key-change-this-in-production

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://mentor:password@localhost:5433/mentor

# =============================================================================
# AI Provider Configuration
# Choose your primary AI provider and configure the corresponding API key
# =============================================================================

# Primary AI Provider Selection
# Options: openrouter, nvidia_nim, groq, google, openai, local
AI_PROVIDER=local

# OpenRouter Configuration (Recommended for access to multiple models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_APP_NAME=AI-Coding-Screener
OPENROUTER_APP_URL=https://github.com/your-username/ai-coding-screener

# NVIDIA NIM Configuration (Great for code-focused models)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/codellama-70b-instruct

# Groq Configuration (Fast inference speeds)
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Google AI Configuration (Gemini models)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# OpenAI Configuration (Fallback option)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Local LLM Configuration (LM Studio, Ollama, etc.)
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=codellama

# =============================================================================
# AI Generation Settings
# =============================================================================
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT=30

# Fallback Configuration
ENABLE_FALLBACK=true
FALLBACK_PROVIDERS=["local","openai"]

# =============================================================================
# Application Features
# =============================================================================
FEATURE_SCREEN_SOURCE=false
FEATURE_EDITOR_SOURCE=true
ENABLED_ANALYZERS=["treesitter","python_ast","ruff"]

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
## Sandbox Configuration
# =============================================================================
SANDBOX_URL=http://localhost:8100
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m

# =============================================================================
# Mentor Configuration
# =============================================================================
HINT_LEVELS=4
MAX_HINTS_PER_SESSION=10

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# API Key Instructions
# =============================================================================
#
# OpenRouter: Get your API key from https://openrouter.ai/keys
# - Provides access to Claude, GPT-4, Llama, and many other models
# - Pay-per-use pricing with competitive rates
# - Example: OPENROUTER_API_KEY=sk-or-v1-xxxxx
#
# NVIDIA NIM: Get your API key from https://build.nvidia.com/
# - Access to optimized inference for code generation models
# - Free tier available with generous limits
# - Example: NVIDIA_NIM_API_KEY=nvapi-xxxxx
#
# Groq: Get your API key from https://console.groq.com/keys
# - Extremely fast inference speeds
# - Free tier with good limits for development
# - Example: GROQ_API_KEY=gsk_xxxxx
#
# Google AI: Get your API key from https://aistudio.google.com/app/apikey
# - Access to Gemini models with long context windows
# - Free tier available
# - Example: GOOGLE_API_KEY=AIzaSyxxxxx
#
# OpenAI: Get your API key from https://platform.openai.com/api-keys
# - Access to GPT-4 and other OpenAI models
# - Pay-per-use pricing
# - Example: OPENAI_API_KEY=sk-xxxxx
#
# Local Setup:
# - Install LM Studio (https://lmstudio.ai/) or Ollama (https://ollama.ai/)
# - Download a coding model (CodeLlama, DeepSeek Coder, etc.)
# - Start the local server and update LOCAL_BASE_URL if needed
#